# Copier en `.env` (déjà gitignoré) et remplir.
# Le jeton se crée dans HA : profil → Sécurité → Jetons d'accès de longue durée.
# Il ne s'affiche qu'une fois.

HA_URL=http://192.168.1.135:8123
HA_TOKEN=

# ── Optionnel ────────────────────────────────────────────────────────────────

# IP de CETTE machine vue depuis HA et depuis la tablette.
# Laisser vide pour détection automatique (première IPv4 non-loopback).
DEV_HOST=

# Port du serveur Vite.
DEV_PORT=5173

# URL de la ressource Lovelace en production, restaurée par `npm run dev:ha -- --restore`.
PROD_RESOURCE_URL=/hacsfiles/ha-owlnest/ha-3d-floorplan.js
